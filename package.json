{
  "name": "llm-thinking-patterns-nakprc",
  "version": "2.0.0",
  "description": "Generate sequential thinking pattern files to study and learn AI reasoning. Plug-and-play extension for Claude Code, Claude Desktop, Cursor, Windsurf, and any MCP-compatible LLM.",
  "type": "module",
  "bin": {
    "thinking-patterns": "./bin/thinking-patterns.mjs",
    "tp-setup": "./.nakprc/installers/tp-setup.mjs"
  },
  "exports": {
    ".": "./src/config.js"
  },
  "scripts": {
    "start": "node bin/thinking-patterns.mjs",
    "generate": "node bin/thinking-patterns.mjs generate",
    "analyze": "node bin/thinking-patterns.mjs analyze",
    "list-patterns": "node bin/thinking-patterns.mjs list-patterns",
    "config": "node bin/thinking-patterns.mjs config",
    "demo": "node bin/thinking-patterns.mjs generate --sample",
    "mcp": "node mcp-server.mjs",
    "setup": "node .nakprc/installers/tp-setup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "keywords": [
    "thinking-patterns",
    "ai-reasoning",
    "chain-of-thought",
    "ai-patterns",
    "prompt-engineering",
    "cli-tool",
    "mcp-server",
    "nakprc",
    "plug-and-play"
  ],
  "license": "MIT",
  "author": "nakprc",
  "engines": {
    "node": ">=18.0.0"
  }
}
